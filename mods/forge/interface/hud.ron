                (id: "info_damage", at: Some((anchor: TopLeft, offset: (10.0, 164.0), pivot: None)), size: (w: Px(248.0), h: Px(20.0)), visible: [PrimaryHas(Weapon)], widget: Text(text: Format("Damage: {0}", [SelectionPrimary(Damage)]), font: Some("forge_ui"), size: 13, colour: "#ffffff", align: Left, wrap: false)),
                (id: "info_range", at: Some((anchor: TopLeft, offset: (10.0, 188.0), pivot: None)), size: (w: Px(248.0), h: Px(20.0)), visible: [PrimaryHas(Weapon)], widget: Text(text: Format("Range: {0}", [SelectionPrimary(Range)]), font: Some("forge_ui"), size: 13, colour: "#ffffff", align: Left, wrap: false)),
                (id: "info_ammo", at: Some((anchor: TopLeft, offset: (10.0, 212.0), pivot: None)), size: (w: Px(248.0), h: Px(20.0)), visible: [PrimaryHas(Weapon)], widget: Text(text: Format("Shells: {0}", [SelectionPrimary(Ammo)]), font: Some("forge_ui"), size: 13, colour: "#ffffff", align: Left, wrap: false)),
