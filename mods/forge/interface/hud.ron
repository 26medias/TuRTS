            widget: Box(fill: Some(Colour("#111820")), border: Some("#425463"), children: [
                (id: "command_heading", at: Some((anchor: TopLeft, offset: (10.0, 6.0), pivot: None)), size: (w: Px(256.0), h: Px(22.0)), widget: Text(text: Literal("Orders"), font: Some("forge_ui"), size: 15, colour: "#ffffff", align: Left, wrap: false)),
                (id: "command_rows", at: Some((anchor: TopLeft, offset: (8.0, 32.0), pivot: None)), size: (w: Px(264.0), h: Px(228.0)), tooltip: Some(Format("{0} [{1}] — {2}", [Item(Name), Item(Title), Item(Body)])), widget: List(source: CommandCard, direction: Vertical, gap: 4, max_items: 9, item: (id: "command", size: (w: Fill, h: Px(28.0)), widget: Button(icon: Some(Item(Icon)), label: Some(Item(Name)), action: Item(Action), hotkey_label: true))))
            ]),
