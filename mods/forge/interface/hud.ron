                (id: "info_owner", at: Some((anchor: TopLeft, offset: (10.0, 34.0), pivot: None)), size: (w: Px(248.0), h: Px(20.0)), widget: Text(text: Literal("Owner: you"), font: Some("forge_ui"), size: 13, colour: "#c8d5dc", align: Left, wrap: false)),
                (id: "info_inventory", at: Some((anchor: TopLeft, offset: (10.0, 58.0), pivot: None)), size: (w: Px(248.0), h: Px(78.0)), widget: Text(text: Format("Inventory: {0}", [SelectionPrimary(Inventory)]), font: Some("forge_ui"), size: 12, colour: "#ffffff", align: Left, wrap: true)),
                (id: "info_health", at: Some((anchor: TopLeft, offset: (10.0, 140.0), pivot: None)), size: (w: Px(248.0), h: Px(20.0)), visible: [PrimaryHas(Movement)], widget: Text(text: Format("Health: {0}/{1}", [SelectionPrimary(Health), SelectionPrimary(MaxHealth)]), font: Some("forge_ui"), size: 13, colour: "#8ee0bd", align: Left, wrap: false)),
