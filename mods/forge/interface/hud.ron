                (id: "group_heading", at: Some((anchor: TopLeft, offset: (8.0, 10.0), pivot: None)), size: (w: Px(56.0), h: Px(20.0)), widget: Text(text: Literal("Groups"), font: Some("forge_ui"), size: 13, colour: "#c8d5dc", align: Left, wrap: false)),
                (id: "group_rows", at: Some((anchor: TopLeft, offset: (68.0, 6.0), pivot: None)), size: (w: Px(546.0), h: Px(28.0)), widget: List(source: ControlGroups, direction: Horizontal, gap: 4, max_items: 9, item: (id: "group", size: (w: Px(56.0), h: Px(24.0)), widget: Text(text: Format("{0}:{1}", [Item(Name), Item(Count)]), font: Some("forge_ui"), size: 12, colour: "#ffffff", align: Centre, wrap: false))))
            ]),
        ),
        (
            id: "alert_panel",
            at: Some((anchor: TopRight, offset: (-8.0, 8.0), pivot: None)),
            size: (w: Px(352.0), h: Px(196.0)),
            widget: Box(fill: Some(Colour("#111820")), border: Some("#425463"), children: [
                (id: "alert_heading", at: Some((anchor: TopLeft, offset: (8.0, 5.0), pivot: None)), size: (w: Px(332.0), h: Px(20.0)), widget: Text(text: Literal("Alerts"), font: Some("forge_ui"), size: 14, colour: "#ffffff", align: Left, wrap: false)),
                (id: "alert_rows", at: Some((anchor: TopLeft, offset: (8.0, 29.0), pivot: None)), size: (w: Px(332.0), h: Px(158.0)), widget: List(source: Alerts, direction: Vertical, gap: 3, max_items: 5, item: (id: "alert_line", size: (w: Fill, h: Px(28.0)), tooltip: Some(Format("{0}. Click to see it.", [Item(Title)])), widget: Button(icon: None, label: Some(Item(Name)), action: Item(Action), hotkey_label: false))))
            ]),
        ),
        (
            id: "last_notice",
            at: Some((anchor: TopLeft, offset: (296.0, 56.0), pivot: None)),
            size: (w: Px(390.0), h: Px(52.0)),
            widget: Text(text: Bind(LastNotice), font: Some("forge_ui"), size: 16, colour: "#ffcc00", align: Left, wrap: true),
        ),
        (
            id: "objective",
            at: Some((anchor: Bottom, offset: (0.0, -8.0), pivot: None)),
            size: (w: Px(700.0), h: Px(58.0)),
            visible: [Not(GuideOpen)],
            widget: Box(fill: Some(Colour("#111820e0")), border: Some("#e69f00"), children: [
                (id: "objective_text", at: Some((anchor: TopLeft, offset: (10.0, 6.0), pivot: None)), size: (w: Px(680.0), h: Px(48.0)), widget: Text(text: Literal("Blue side: make your Shell Turret hit harder. Click the Proving Lab (the top big blue building), then research Hardened Shells.\nOrange side: click your orange drone, then find the blue Shell Turret and its range."), font: Some("forge_ui"), size: 15, colour: "#ffffff", align: Left, wrap: true)),
            ]),
        ),
        (
            id: "minimap",
            at: Some((anchor: BottomRight, offset: (-8.0, -8.0), pivot: None)),
            size: (w: Px(208.0), h: Px(200.0)),
            layer: 2,
            widget: MinimapView(background: Some(Colour("#17232f")), frame: "#ffffff", unit_size: 2.0, ping: Some("#ffcc00")),
        ),
        (
            id: "guide",
            size: (w: Fill, h: Fill),
            layer: 40,
            visible: [GuideOpen],
            widget: Box(fill: Some(Colour("#07111ed0")), border: Some("#425463"), children: [
                (id: "guide_copy", at: Some((anchor: TopLeft, offset: (36.0, 36.0), pivot: None)), size: (w: Px(430.0), h: Px(640.0)), widget: Text(text: Bind(Guide), font: Some("forge_ui"), size: 17, colour: "#ffffff", align: Left, wrap: true)),
                (id: "guide_close_fill", at: Some((anchor: TopLeft, offset: (1176.0, 12.0), pivot: None)), size: (w: Px(96.0), h: Px(48.0)), layer: 2, widget: Box(fill: Some(Colour("#e69f00")), border: Some("#ffffff"), children: [])),
                (id: "guide_close", at: Some((anchor: TopLeft, offset: (1178.0, 14.0), pivot: None)), size: (w: Px(92.0), h: Px(44.0)), layer: 3, tooltip: Some(Literal("Close the guide")), widget: Button(icon: None, label: Some(Literal("Close")), action: Input("toggle_guide"), hotkey_label: false)),
            ]),
        ),
    ],
    tooltip_style: (background: "#111820", colour: "#ffffff", font: Some("forge_ui"), size: 14),
    cursors: {
        "default": "forge_cursor_default",
        "select": "forge_cursor_select",
        "move": "forge_cursor_move",
        "attack": "forge_cursor_attack",
        "gather": "forge_cursor_gather",
        "forbidden": "forge_cursor_forbidden",
    },
    camera: (pitch: 0.70, yaw: 0.0, field_of_view: 60.0, minimum: 12.0, maximum: 50.0, start: OwnedCentre, height: 28.0, margin: 0.0, pan_speed: 1.0, edge_band: true),
    light: Some((direction: (-0.5, -1.0, -0.4), colour: "#ffffff", illuminance: 10000.0, ambient: 0.3)),
    slot_colours: ["#0072B2", "#E69F00"],
    world: (ground: "#34424d", grid: "#50616d", selection: "#ffffff", health: "#56d4a8", range: "#f2cc60", show_range: true, tooltip: (background: "#111820", colour: "#ffffff", font: Some("forge_ui"), size: 14), health_bar: (width: 48, height: 6, background: "#182029", health: "#56d4a8")),
    alerts: [
        (id: "forge_research_ready", trigger: ResearchReady, sound: Some("forge_alert"), text: "Proving Lab can research Hardened Shells", minimap_ping: true, cooldown: 1.0, priority: 10, coalesce_radius: 5.0),
        (id: "forge_research_complete", trigger: ResearchComplete, sound: Some("forge_alert"), text: "Hardened Shells done: the turret hits harder", minimap_ping: true, cooldown: 1.0, priority: 12, coalesce_radius: 5.0),
        (id: "forge_out_of_ammo", trigger: OutOfAmmo, sound: Some("forge_alert"), text: "Shell Turret is out of shells", minimap_ping: true, cooldown: 60.0, priority: 15, coalesce_radius: 5.0),
        (id: "forge_output_blocked", trigger: OutputBlocked, sound: Some("forge_alert"), text: "Shell Press is full: no room for its shells", minimap_ping: true, cooldown: 60.0, priority: 11, coalesce_radius: 5.0),
        (id: "forge_loader_waiting", trigger: InserterWaiting(5.0), sound: Some("forge_alert"), text: "An Arm Loader is waiting for an item", minimap_ping: true, cooldown: 1.0, priority: 8, coalesce_radius: 5.0),
        (id: "forge_unit_damaged", trigger: OwnUnitDamaged, sound: Some("forge_alert"), text: "A unit is under attack", minimap_ping: true, cooldown: 5.0, priority: 10, coalesce_radius: 5.0),
        (id: "forge_unit_destroyed", trigger: OwnUnitDestroyed, sound: Some("forge_alert"), text: "A unit was destroyed", minimap_ping: true, cooldown: 1.0, priority: 18, coalesce_radius: 5.0),
    ],
    reasons: {
        "not_owner": "That unit belongs to the other side.",
        "not_applicable": "That action is not available for this unit.",
        "unknown_order": "That order is not available.",
        "target_invalid": "That is not a valid target.",
        "target_gone": "That target is gone.",
        "out_of_range": "That target is out of range.",
        "queue_full": "The lab queue is full.",
        "not_queueable": "This order cannot be queued.",
        "blocked": "The unit cannot reach that place.",
        "no_applicable_order": "Cannot move. It is fixed in place.",
        "queue_disabled": "The machine is switched off.",
        "already_researched": "This upgrade is complete.",
        "already_researching": "This upgrade is already under way.",
    },
    units: {
        "forge:drill": (icon: Some("forge_portrait_drill"), portrait: Some("forge_portrait_drill"), responses: {"select": ["forge_voice_select"], "order": ["forge_voice_order"], "error": ["forge_effect_error"]}),
        "forge:belt": (icon: Some("forge_portrait_belt"), portrait: Some("forge_portrait_belt"), responses: {"select": ["forge_voice_select"], "order": ["forge_voice_order"], "error": ["forge_effect_error"]}),
        "forge:arm_loader": (icon: Some("forge_portrait_arm_loader"), portrait: Some("forge_portrait_arm_loader"), responses: {"select": ["forge_voice_select"], "order": ["forge_voice_order"], "error": ["forge_effect_error"]}),
        "forge:press": (icon: Some("forge_portrait_press"), portrait: Some("forge_portrait_press"), responses: {"select": ["forge_voice_select"], "order": ["forge_voice_order"], "error": ["forge_effect_error"]}),
        "forge:turret": (icon: Some("forge_portrait_turret"), portrait: Some("forge_portrait_turret"), responses: {"select": ["forge_voice_select"], "order": ["forge_voice_order"], "error": ["forge_effect_error"]}),
        "forge:lab": (icon: Some("forge_portrait_lab"), portrait: Some("forge_portrait_lab"), responses: {"select": ["forge_voice_select"], "order": ["forge_voice_order"], "error": ["forge_effect_error"]}),
        "forge:drone": (icon: Some("forge_portrait_drone"), portrait: Some("forge_portrait_drone"), responses: {"select": ["forge_voice_select"], "order": ["forge_voice_order"], "error": ["forge_effect_error"]}),
    },
    selection_priority: ["forge:drill", "forge:press", "forge:lab", "forge:turret", "forge:arm_loader", "forge:belt", "forge:drone"],
    guide: [
        (id: "goal", title: "Your goal", body: "Blue side: make your Shell Turret hit harder. Research Hardened Shells in the Proving Lab, the top big blue building.\nOrange side: find the blue Shell Turret and see how far it shoots."),
        (id: "research", title: "Research Hardened Shells", body: "Click the Proving Lab. Shells come to it by themselves. When it holds 10, click Hardened Shells. Then click the turret: its damage goes from 10 to 20."),
        (id: "pause", title: "Disable and enable", body: "Click the Shell Press, then click Disable this machine. It stops. Click Enable this machine to start it again."),
        (id: "drones", title: "Your drone (orange side)", body: "Click your drone. Right-click the ground to move it. To queue a second point, use the queue key on the last page. Click a blue building to see its name and range."),
        (id: "controls", title: "Keys", body: "Point at anything to see its name. Left click selects; drag to select many. Right click gives an order; hold Shift to queue it. Click an alert to go to its place. The list shows every key, with the keys for this guide and for Settings, where you can change any key.", widgets: [
            (id: "controls_heading", at: Some((anchor: TopLeft, offset: (490.0, 64.0), pivot: None)), size: (w: Px(700.0), h: Px(24.0)), layer: 60, widget: Text(text: Literal("Controls"), font: Some("forge_ui"), size: 18, colour: "#ffffff", align: Left, wrap: false)),
            (id: "bindings", at: Some((anchor: TopLeft, offset: (490.0, 94.0), pivot: None)), size: (w: Px(700.0), h: Px(584.0)), layer: 60, widget: List(source: Bindings, direction: Vertical, gap: 4, max_items: 64, item: (id: "binding", size: (w: Fill, h: Px(24.0)), widget: Text(text: Format("{0}: {1}", [Item(Name), Item(Title)]), font: Some("forge_ui"), size: 12, colour: "#ffffff", align: Left, wrap: false)))),
        ]),
    ],
)
