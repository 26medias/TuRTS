                (id: "queue_rows", at: Some((anchor: TopLeft, offset: (8.0, 27.0), pivot: None)), size: (w: Px(256.0), h: Px(100.0)), widget: List(source: ProductionQueue, direction: Vertical, gap: 4, max_items: 2, item: (id: "job", size: (w: Fill, h: Px(86.0)), widget: Box(fill: Some(Colour("#253542")), border: Some("#425463"), children: [
                    (id: "job_name", at: Some((anchor: TopLeft, offset: (6.0, 4.0), pivot: None)), size: (w: Px(244.0), h: Px(18.0)), widget: Text(text: Item(Name), font: Some("forge_ui"), size: 13, colour: "#ffffff", align: Left, wrap: false)),
                    (id: "job_seconds", at: Some((anchor: TopLeft, offset: (6.0, 25.0), pivot: None)), size: (w: Px(244.0), h: Px(16.0)), widget: Text(text: Format("{0}s remaining", [Item(RemainingSeconds)]), font: Some("forge_ui"), size: 12, colour: "#c8d5dc", align: Left, wrap: false)),
                    (id: "job_progress", at: Some((anchor: TopLeft, offset: (6.0, 47.0), pivot: None)), size: (w: Px(164.0), h: Px(12.0)), widget: Bar(value: Item(Progress), max: Literal("1"), fill: Colour("#56b4e9"), background: Colour("#182029"), direction: Right)),
                    (id: "job_cancel", at: Some((anchor: TopLeft, offset: (177.0, 43.0), pivot: None)), size: (w: Px(72.0), h: Px(28.0)), tooltip: Some(Literal("Cancel this job")), widget: Button(icon: None, label: Some(Literal("Cancel")), action: Item(CancelAction), hotkey_label: false)),
                ]))))
            ]),
        ),
        (
