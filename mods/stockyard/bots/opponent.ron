(
 id: "opponent", name: "Stockyard opponent", decision_ms: 1000, start_when: MatchRunning,
 controllers: [
  (key: "opening", factory: "engine:opening", config: Null, quota: (queries: 4, candidates: 512, rows: 128, proposals: 4)),
  (key: "economy", factory: "engine:economy", config: Null, quota: (queries: 12, candidates: 1536, rows: 384, proposals: 12)),
  (key: "production", factory: "engine:production", config: Null, quota: (queries: 8, candidates: 1024, rows: 256, proposals: 8)),
  (key: "squads", factory: "engine:squads", config: Null, quota: (queries: 8, candidates: 1024, rows: 256, proposals: 8)),
 ],
 knowledge: (
  roles: [
   (key: "home", units: ["stockyard:base"]),
   (key: "workers", units: ["stockyard:worker"], requires: [Gatherer]),
   (key: "builders", units: ["stockyard:builder"], requires: [Constructor]),
   (key: "trainers", units: ["stockyard:barracks"], requires: [Producer]),
   (key: "worker_trainers", units: ["stockyard:barracks"], requires: [Producer]),
   (key: "defenses", units: ["stockyard:tower"]),
   (key: "ranged", units: ["stockyard:soldier"]),
   (key: "melee", units: ["stockyard:swordsman"]),
   (key: "heavy", units: ["stockyard:warrior"]),
   (key: "army", units: ["stockyard:soldier", "stockyard:swordsman", "stockyard:warrior"], requires: [Movement, Weapon]),
  ],
  orders: [
   (key: "worker_train", order: "stockyard:order_produce", actor_role: "worker_trainers"),
   (key: "army_train", order: "stockyard:order_produce", actor_role: "trainers"),
   (key: "build", order: "stockyard:order_construct", actor_role: "builders"),
   (key: "gather", order: "stockyard:order_gather", actor_role: "workers"),
   (key: "attack", order: "stockyard:order_attack", actor_role: "army"),
   (key: "move", order: "stockyard:order_move", actor_role: "army"),
  ],
  recipes: [
   (key: "worker", recipe: "stockyard:train_worker", actor_role: "worker_trainers", order: "worker_train", kind: Produce),
   (key: "trainer", recipe: "stockyard:build_barracks", actor_role: "builders", order: "build", kind: Construct),
   (key: "tower", recipe: "stockyard:build_tower", actor_role: "builders", order: "build", kind: Construct),
   (key: "ranged", recipe: "stockyard:train_soldier", actor_role: "trainers", order: "army_train", kind: Produce),
   (key: "melee", recipe: "stockyard:train_swordsman", actor_role: "trainers", order: "army_train", kind: Produce),
   (key: "heavy", recipe: "stockyard:train_warrior", actor_role: "trainers", order: "army_train", kind: Produce),
  ],
  opening: [
   (key: "build_trainer", priority: 40, action: EnsureUnits(role: "trainers", count: 1, recipe: "trainer")),
   (key: "expand_workers", priority: 30, action: EnsureUnits(role: "workers", count: 6, recipe: "worker")),
   (key: "build_defenses", priority: 20, action: EnsureUnits(role: "defenses", count: 2, recipe: "tower")),
  ],
  recovery: [
   (key: "recover_worker", priority: 100, action: EnsureUnits(role: "workers", count: 1, recipe: "worker")),
   (key: "harvest", priority: 90, action: Gather(role: "workers", resource: "stockyard:wood", order: "gather")),
  ],
  production: [
   (key: "ranged_target", role: "ranged", count: 8, recipe: "ranged", priority: 30),
   (key: "melee_target", role: "melee", count: 4, recipe: "melee", priority: 25),
   (key: "heavy_target", role: "heavy", count: 2, recipe: "heavy", priority: 20),
  ],
  squads: [(key: "main_army", role: "army", min_units: 4, anchor_role: "home", attack_order: "attack", move_order: "move", defend_radius: 18.0, assemble_radius: 8.0, priority: 50)],
 ),
)
