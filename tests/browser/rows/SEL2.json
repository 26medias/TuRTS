    { "label": "sel2-shift-remove", "gesture": "click", "selector": "mobile-slot0", "modifiers": ["Shift"], "owner_slot": 0, "expected_selection": 2, "expected_rings": 2 },
    { "label": "sel2-mixed-owner", "gesture": "box", "selector": "500-mobile-plus-visible-foreign", "owner_slot": 0, "expected_selection": 500, "expected_rings": 500 }
